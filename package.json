{
  "name": "tbpedia-update",
  "version": "1.0.0",
  "private": true,
  "description": "Managed Tbpedia content updates for Obsidian",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "check": "tsc --noEmit",
    "worker:dev": "wrangler dev --config worker/wrangler.toml",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "worker:check": "tsc --noEmit -p worker/tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.6.0",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "jszip": "^3.10.1"
  }
}
